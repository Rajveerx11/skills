# Normalize all text files to LF in the repo; check out native on each platform.
* text=auto eol=lf

# Explicitly treat common binary asset types as binary (never line-ending munged).
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.svg    binary
*.pdf    binary
*.docx   binary
*.xlsx   binary
*.pptx   binary
*.zip    binary
*.gz     binary
*.mp3    binary
*.wav    binary
*.mp4    binary
*.mov    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary

# Windows-only helper scripts keep CRLF.
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf
